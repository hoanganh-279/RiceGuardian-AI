# Staff API (port 5001) — local BLB + field cover
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=8
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5001
# Farmer app API (run_app.py)
APP_PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty / placeholder → SQLite (riceguardian.db under cwd)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Multispectral 6-channel U-Net weights (config.json must sit next to best.pth)
BLB_UAV_SEG_MODEL_PATH=../web/blb_uav_seg_ms_d2/best.pth
# Band indices (0–5) for the display-only preview PNG; channel order is unverified
BLB_MS_PREVIEW_BANDS=0,1,2
