# Site API (port 5002) — marketing Google + contact form
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=8
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5002
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,https://riceguardianai.io.vn,https://www.riceguardianai.io.vn,https://riceguardian-site.onrender.com

SITE_GOOGLE_CLIENT_ID=your-site-web-client-id.apps.googleusercontent.com
# 0 = Google login issues a session right away (no 6-digit email code).
# Render free plan blocks outbound SMTP, so set 0 there.
SITE_REQUIRE_EMAIL_CODE=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=riceguardianai@gmail.com
SMTP_PASSWORD=your-gmail-app-password
CONTACT_INBOX=riceguardianai@gmail.com
